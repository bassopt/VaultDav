
# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# --- VaultDAV & Syncthing Container Stack Configuration ---
PUID=1000
PGID=1000
TZ=UTC
WEBDAV_PORT=8080
SYNCTHING_GUI_PORT=8384
SYNCTHING_SYNC_PORT=22000

# Master key used to derive AES-256-GCM encryption key for SQLite credentials
SQLITE_MASTER_KEY="vaultdav-aes256-gcm-master-secret-key-2026"
SQLITE_DB_PATH="/data/db/vaultdav.sqlite"

# --- Host Folders Exposed to Containers (Controlled via .env) ---
EXPOSE_FOLDER_DOCUMENTS=true
HOST_PATH_DOCUMENTS="./host_volumes/documents"
CONTAINER_PATH_DOCUMENTS="/var/webdav/documents"

EXPOSE_FOLDER_MEDIA=true
HOST_PATH_MEDIA="./host_volumes/media"
CONTAINER_PATH_MEDIA="/var/webdav/media"

EXPOSE_FOLDER_PROJECTS=true
HOST_PATH_PROJECTS="./host_volumes/projects"
CONTAINER_PATH_PROJECTS="/var/webdav/projects"

EXPOSE_FOLDER_BACKUPS=false
HOST_PATH_BACKUPS="./host_volumes/backups"
CONTAINER_PATH_BACKUPS="/var/webdav/backups"

EXPOSE_FOLDER_PHOTOS=false
HOST_PATH_PHOTOS="./host_volumes/photos"
CONTAINER_PATH_PHOTOS="/var/webdav/photos"
